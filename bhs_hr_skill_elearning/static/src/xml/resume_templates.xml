<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <t t-inherit="hr_skills.ResumeListRenderer.RecordRow" t-inherit-mode="extension">
        <xpath expr="//h4[hasclass('o_resume_line_title')]" position="after">
            <span t-if="data.course_url &amp;&amp; data.completed"
                class="fa fa-check-circle text-success ms-2"
                title="Completed"/>
            <span t-if="data.course_url &amp;&amp; !data.completed"
                class="fa fa-circle-o text-muted ms-2"
                title="In Progress"/>
        </xpath>
    </t>
</odoo>
